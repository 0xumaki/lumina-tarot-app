// Lumina — Tarot · Manifestation · Frequencies
// Prisma schema (PostgreSQL — Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Anonymous device-based identity. No email/password friction.
model Device {
  id          String   @id @default(cuid())
  deviceId    String   @unique // client-generated stable id (localStorage)
  displayName String?
  isPremium   Boolean  @default(false)
  premiumSince DateTime?
  xp          Int      @default(0) // cumulative experience points for the 36-level journey
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  readings          Reading[]
  goals             Goal[]
  frequencySessions FrequencySession[]
  usageLogs         UsageLog[]
  confirmations     Confirmation[]
  moods             Mood[]
  insightFeedback   InsightFeedback[]
  ritualLogs        RitualLog[]
}

/// A tarot reading session.
model Reading {
  id          String   @id @default(cuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  question    String
  spreadType  String   // "yes-no" | "single" | "three-card" | "celtic-cross" | "relationship" | "career" | "card-of-day"
  cardsJson   String   // JSON array of { id, reversed, position }
  interpretation String // AI-generated interpretation (markdown-ish)
  isPremium   Boolean  @default(false)
  saved       Boolean  @default(false) // bookmarked by user
  createdAt   DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([deviceId, saved])
}

/// A manifestation goal.
model Goal {
  id            String   @id @default(cuid())
  deviceId      String
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  title         String
  intention     String   // e.g. "abundance", "love", "health"
  statement     String   // the full affirmation the user confirms daily
  reminderTime  String   // "HH:mm" local time
  targetDate    DateTime?
  frequencyHz   Int?     // suggested frequency
  status        String   @default("active") // "active" | "achieved" | "archived"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  confirmations Confirmation[]

  @@index([deviceId, status])
}

/// Daily confirmation log for a goal.
model Confirmation {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD" — one confirmation per goal per day
  note      String?
  createdAt DateTime @default(now())

  @@unique([goalId, date])
  @@index([deviceId, date])
}

/// Frequency listening session.
model FrequencySession {
  id          String   @id @default(cuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  intention   String   // "abundance", "love", ...
  frequencyHz Int
  baseHz      Int?     // carrier for binaural
  beatHz      Int?     // binaural beat frequency
  mode        String   // "pure" | "binaural" | "pad"
  durationSec Int
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([deviceId, createdAt])
}

/// Daily usage tracking for free-tier limits.
/// One row per device per day.
model UsageLog {
  id            String   @id @default(cuid())
  deviceId      String
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  date          String   // "YYYY-MM-DD"
  tarotReadings Int      @default(0)
  frequencySec  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([deviceId, date])
}

/// Daily mood check-in — one per device per day.
model Mood {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD"
  mood      Int      // 1-5 scale
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, date])
  @@index([deviceId, date])
}

/// User feedback on AI-generated insights (thumbs up/down).
model InsightFeedback {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type      String   // "energy_signature" | "weekly_reflection"
  rating    String   // "up" | "down"
  note      String?
  createdAt DateTime @default(now())

  @@index([deviceId, type, createdAt])
}

/// Daily ritual completion — tracks which ritual steps were done each day.
model RitualLog {
  id           String   @id @default(cuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  date         String   // "YYYY-MM-DD"
  step1Cleanse Boolean  @default(false)
  step2Manifest Boolean @default(false)
  step3Tarot   Boolean  @default(false)
  step4Balance Boolean  @default(false)
  completed    Boolean  @default(false) // true when steps 1,2,4 are done (3 optional)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([deviceId, date])
  @@index([deviceId, date])
}
